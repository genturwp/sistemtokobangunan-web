# Environment of stb-web. Install a copy as /etc/stb-web/env, owned by user stb, mode 0600:
#   install -o stb -g stb -m 0600 deploy/env.example /etc/stb-web/env
# then replace the placeholder values. Never commit real values.
#
# Read by systemd (EnvironmentFile=) and by the backup cron job (sourced by /bin/sh), so keep
# one KEY=value per line, no quotes, no spaces, and comments on their own lines only.

# Loopback only; Caddy is the only thing in front of it.
STB_BIND=127.0.0.1:8080
STB_DATABASE_PATH=/var/lib/stb-web/stb.db
# Public base URL, no trailing slash.
STB_BASE_URL=https://sistemtokobangunan.com
# The owner's WhatsApp number for https://wa.me/<number> links: digits only, country code
# first, no "+", no spaces or dashes, e.g. 6281234567890. stb-web refuses to start unless it
# is 62 followed by 8 to 13 digits (the placeholder below is refused).
STB_WHATSAPP_NUMBER=REPLACE_WITH_DIGITS_ONLY_NUMBER
# The site's public contact email, shown as a mailto: link next to WhatsApp on the home and
# privacy pages, e.g. halo@example.com. stb-web refuses to start unless it has exactly one "@"
# with text on both sides, a "." in the part after "@", no spaces, and at most 254 characters
# (the placeholder below is refused).
STB_CONTACT_EMAIL=REPLACE_WITH_CONTACT_EMAIL
RUST_LOG=info
